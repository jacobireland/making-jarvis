{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/relay.js session-start",
        "timeout": 5000
      }
    ],
    "afterAgentThought": [
      {
        "command": "node .cursor/hooks/relay.js after-agent-thought",
        "timeout": 5000
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/relay.js after-agent-response",
        "timeout": 5000
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/relay.js stop",
        "timeout": 5000
      }
    ]
  }
}
