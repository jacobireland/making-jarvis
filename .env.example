# Voice Cursor local service configuration
# Copy to `.env` in the repo root (never commit `.env`)

# STT engine: auto | whisper-openai | whisper-groq | windows
# auto = OpenAI Whisper if key present, else Groq, else Windows System.Speech
VOICE_CURSOR_STT=auto

# OpenAI Whisper (recommended for accuracy)
OPENAI_API_KEY=
# VOICE_CURSOR_OPENAI_API_KEY=
# VOICE_CURSOR_WHISPER_MODEL=whisper-1

# Or Groq Whisper (fast/cheap alternative)
# GROQ_API_KEY=
# VOICE_CURSOR_GROQ_API_KEY=
# VOICE_CURSOR_GROQ_WHISPER_MODEL=whisper-large-v3

# Service bind
# VOICE_CURSOR_HOST=127.0.0.1
# VOICE_CURSOR_PORT=4738
