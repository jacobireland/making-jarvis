# Voice Cursor local config (copy to `.env` in repo root — do not commit)

# STT: auto (OpenAI Whisper if key present, else Windows) | openai | windows
VOICE_CURSOR_STT=auto

# Required for OpenAI Whisper
OPENAI_API_KEY=sk-...

# Optional
# VOICE_CURSOR_WHISPER_MODEL=whisper-1
# VOICE_CURSOR_TTS=edge
# VOICE_CURSOR_TTS_VOICE=en-PH-JamesNeural
# Speaking rate: 1.0 = normal, 1.25 = default (faster), 1.5 = quite fast
# VOICE_CURSOR_TTS_RATE=1.25
