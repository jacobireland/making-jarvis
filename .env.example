# Voice Cursor local config (copy to `.env` in repo root — do not commit)

# STT: auto (Deepgram → Whisper → Windows) | deepgram | openai | windows
VOICE_CURSOR_STT=auto

# TTS: auto (Deepgram Aura if key, else Edge) | deepgram | edge | windows
VOICE_CURSOR_TTS=auto

# Deepgram — one key covers STT (Nova) + TTS (Aura)
DEEPGRAM_API_KEY=...

# Optional OpenAI Whisper fallback
# OPENAI_API_KEY=sk-...

# Optional tuning
# VOICE_CURSOR_DEEPGRAM_STT_MODEL=nova-3
# VOICE_CURSOR_TTS_VOICE=aura-2-odysseus-en
# VOICE_CURSOR_TTS_RATE=1.25
# VOICE_CURSOR_WHISPER_MODEL=whisper-1
# Edge fallback voice if no Deepgram:
# VOICE_CURSOR_TTS_VOICE=en-PH-JamesNeural
