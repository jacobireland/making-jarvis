# Voice Cursor local config (copy to `.env` in repo root — do not commit)

# STT: auto (Deepgram → Whisper → Windows) | deepgram | openai | windows
VOICE_CURSOR_STT=auto

# TTS: auto (Deepgram Flux if key, else Edge) | deepgram | edge | windows
VOICE_CURSOR_TTS=auto

# Deepgram — one key covers STT (Nova) + TTS (Flux/Aura)
DEEPGRAM_API_KEY=...

# Optional OpenAI Whisper fallback
# OPENAI_API_KEY=sk-...

# Hands-free / VAD (Flux /v2/listen EndOfTurn). Default on when Deepgram is set.
# VOICE_CURSOR_VAD=true
# VOICE_CURSOR_EOT_THRESHOLD=0.7
# VOICE_CURSOR_EOT_TIMEOUT_MS=7000
# VOICE_CURSOR_STT_STREAM=auto
# VOICE_CURSOR_FLUX_STT_MODEL=flux-general-en

# Optional tuning
# VOICE_CURSOR_DEEPGRAM_STT_MODEL=nova-3
# Flux Marcelo (default): WebSocket stream /v2/speak (REST fallback)
VOICE_CURSOR_TTS_VOICE=flux-marcelo-en
VOICE_CURSOR_TTS_RATE=1.1
# Streaming TTS for Flux (auto|on|off). Same Deepgram usage cost as REST.
# VOICE_CURSOR_TTS_STREAM=auto
# Other Flux voices: flux-alexis-en, flux-haley-en, …
# Aura (v1 REST): aura-2-odysseus-en
# VOICE_CURSOR_MAX_SPOKEN_CHARS=2500
# Speak Agent thinking blocks during voice turns (afterAgentThought). Set 0 to disable.
# VOICE_CURSOR_SPEAK_THOUGHTS=true
# Speak the full expanded Thought body instead of only the last sentence.
# VOICE_CURSOR_SPEAK_FULL_THOUGHTS=false
